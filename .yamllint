extends: default

rules:
  # Require document start marker
  document-start:
    present: true

  # Line length limit (80 characters)
  line-length:
    max: 80
    level: error

  # No trailing spaces
  trailing-spaces:
    level: error

  # Indentation
  indentation:
    spaces: 2
    indent-sequences: true
    check-multi-line-strings: false

  # Comments
  comments:
    min-spaces-from-content: 1

  # Empty lines
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

  # Truthy values
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
