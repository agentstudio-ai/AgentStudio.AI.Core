---
extends: default

rules:
  line-length:
    max: 80
  comments-indentation:
    level: warning
  document-start:
    present: true
  new-lines: disable
  # Alternative: Allow both Unix and Windows line endings
  # new-lines:
  #   type: unix
  #   check-missing: false

ignore: |
  README.md
  CHANGELOG.md
  CONTRIBUTING.md
  *.md
  dist/
  src/bin/
  src/obj/
  scripts/
  docs/
  images/
  .MyWorkspace/
  .github/workflows/*.yml
  src/templates/**/*.yml
