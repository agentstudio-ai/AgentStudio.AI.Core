<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Framework target (required but won't be used for compilation) -->
    <TargetFramework>netstandard2.0</TargetFramework>
    
    <!-- Key setting: Exclude compiled assemblies from package -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    
    <!-- Package configuration -->
    <PackageId>AgentStudio.AI.Core</PackageId>
    <Version>0.4.0-beta</Version>
    <Authors>AgentStudio.AI</Authors>
    <Company>AgentStudio.AI</Company>
    <Product>AgentStudio.AI Core Framework</Product>
    <Description>Human-Centric AI Agent Orchestration Framework - Core templates and patterns for building AI agents</Description>
    <PackageProjectUrl>https://github.com/agentstudio-ai/AgentStudio.AI.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/agentstudio-ai/AgentStudio.AI.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;agents;orchestration;templates;cognitive;workflow</PackageTags>
    <PackageReadmeFile>content/README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**/*.yml;templates/**/*.yaml;templates/**/*.md;templates/**/*.txt">
      <Pack>true</Pack>
      <PackagePath>content/templates/</PackagePath>
    </Content>
    <Content Include="shared-knowledge/**/*.yml;shared-knowledge/**/*.yaml;shared-knowledge/**/*.md;shared-knowledge/**/*.txt">
      <Pack>true</Pack>
      <PackagePath>content/shared-knowledge/</PackagePath>
    </Content>
    <Content Include="../README.md">
      <Pack>true</Pack>
      <PackagePath>content/</PackagePath>
    </Content>
    <Content Include="../LICENSE">
      <Pack>true</Pack>
      <PackagePath>content/</PackagePath>
    </Content>
    <Content Include="../VERSION">
      <Pack>true</Pack>
      <PackagePath>content/</PackagePath>
    </Content>
  </ItemGroup>

</Project>
