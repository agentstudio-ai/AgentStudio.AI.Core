# Set default behavior to automatically normalize line endings
* text=auto

# Force Unix line endings for YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Force Unix line endings for other text files
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
