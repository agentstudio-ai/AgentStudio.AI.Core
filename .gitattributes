# Set default behavior to automatically normalize line endings
* text=auto

# Force Unix line endings for YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Force Unix line endings for shell scripts
*.sh text eol=lf

# Force Unix line endings for PowerShell scripts
*.ps1 text eol=lf

# Force Unix line endings for configuration files
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary